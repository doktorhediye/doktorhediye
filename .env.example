# Kopyasını .env.local veya sunucunun gizli ortam değişkenlerinde tutun; GitHub'a koymayın.
APP_SECRET=
ADMIN_TOKEN=
PUBLIC_URL=http://127.0.0.1:4180
APP_ENV=development
DATABASE_PATH=backend/runtime/orders.sqlite3
PAYMENT_MODE=disabled
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Canlı satış için ayrıca backend/catalog.json prices_confirmed=true gerekir.
LIVE_SALES_CONFIRMED=no
# Yalnız güvenilir ters proxy gelen X-Real-IP başlığını silip yeniden yazıyorsa doldurun.
TRUSTED_PROXY_IP=
# Test ortamında PayTR'nin istediği gerçek dış istemci IP'si; canlıda kullanılmaz.
PAYTR_TEST_USER_IP=

# Owner-only order email notifications via verified Resend sender.
MAIL_ENABLED=no
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=doktorhediye@hotmail.com
MAIL_NOTIFY_TEST=no
